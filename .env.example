# Copie para .env (ou rode ./setup.sh, que gera senhas aleatórias)

TZ=America/Rio_Branco

# Versões (fixe as tags em produção)
GUAC_VERSION=1.6.0
MYSQL_TAG=8.4
NPM_TAG=latest

# Caminho do Guacamole no domínio: https://SEU_DOMINIO/acesso/
# Só letras, números, - e _. Tem que bater com o location do NPM.
GUAC_PATH=acesso

# Banco
MYSQL_DATABASE=guacamole_db
MYSQL_USER=guacamole_user
MYSQL_PASSWORD=TROQUE_ESTA_SENHA
MYSQL_ROOT_PASSWORD=TROQUE_ESTA_SENHA_TAMBEM

# Nome que aparece no app autenticador
TOTP_ISSUER=Secure Access

# Força bruta: tentativas erradas antes do bloqueio / duração do bloqueio (s)
BAN_MAX_INVALID_ATTEMPTS=5
BAN_ADDRESS_DURATION=600

# Painel do NPM (porta 81). 127.0.0.1 = só pelo próprio servidor
# (acesse com: ssh -L 8181:127.0.0.1:81 usuario@servidor → http://localhost:8181).
# Use 0.0.0.0 apenas na configuração inicial e volte depois.
NPM_ADMIN_BIND=127.0.0.1
